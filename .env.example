# ═══════════════════════════════════════════════════════════════════════════════
# REELASSATI — Environment Variables
# Copy this file to .env and fill in all values
# ═══════════════════════════════════════════════════════════════════════════════

# ── App Identity ─────────────────────────────────────────────────────────────
APP_ID=                   # App ID (from your portal)
APP_SECRET=               # App secret (for JWT signing)

# ── Frontend ─────────────────────────────────────────────────────────────────
VITE_APP_ID=              # Same as APP_ID (exposed to frontend)
VITE_APP_URL=             # Your production URL (e.g. https://reelassati.vercel.app)
VITE_PLATFORM_API_ORIGIN= # Optional public product API origin for split frontend deployments
VITE_SUPABASE_URL= # Product-auth Supabase URL (publishable client configuration)
VITE_SUPABASE_PUBLISHABLE_KEY= # Supabase sb_publishable_ key; never use a service-role key here
VITE_AUTH_REDIRECT_ORIGIN=      # Canonical auth return origin, normally https://www.reelassati.app
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN= # PostHog public project token
VITE_PUBLIC_POSTHOG_HOST=          # PostHog ingestion host

# ── Database ─────────────────────────────────────────────────────────────────
# Supabase/Vercel: postgres://postgres.[project]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=             # PostgreSQL connection string

# ── Google OAuth (optional — for sign-in with Google) ────────────────────────
VITE_GOOGLE_CLIENT_ID=    # From Google Cloud Console
GOOGLE_CLIENT_SECRET=     # From Google Cloud Console

# ── OpenRouter (LLM + Whisper + TTS + Video) ─────────────────────────────────
OPENROUTER_API_KEY=       # sk-or-v1-... (covers Kimi, Whisper, MiniMax TTS, HappyHorse video)
OPENROUTER_TREND_MODEL=moonshotai/kimi-k2.5 # Optional; weekly/custom trend research defaults to Kimi
KIMI_TEST_MODE=disabled   # Set to enabled only for owner-only subscription testing
KIMI_CODE_API_KEY=        # Kimi Code Console subscription key; never commit a real value
KIMI_CODE_MODEL=k3-256k   # Test-only text model; OpenRouter remains the official fallback

# ── Zernio (Social Media Publishing) ─────────────────────────────────────────
ZERNIO_API_KEY=           # From zernio.com (first 2 accounts free)

# ── Stripe (Subscriptions + Credit Top-ups) ─────────────────────────────────
STRIPE_SECRET_KEY=        # Stripe restricted/live secret; server only
STRIPE_WEBHOOK_SECRET=    # Signing secret for /api/billing/stripe-webhook
STRIPE_ACCOUNT_ID=        # Expected account ID; prevents using another account's key
STRIPE_PORTAL_CONFIGURATION_ID=  # bpc_... from the provisioned customer portal
STRIPE_TAX_MODE=automatic # Requires active tax settings and registration; not_collecting only after explicit tax review
STRIPE_PRICE_IDS_JSON=    # {"plans":{"creator":{"monthly":"price_...","annual":"price_..."},"pro":{...},"studio":{...}},"topUps":{"boost":"price_...","momentum":"price_...","scale":"price_..."}}
PUBLIC_APP_URL=https://www.reelassati.app

# ── Pixabay (Stock Images) ───────────────────────────────────────────────────
PIXABAY_API_KEY=          # From pixabay.com/api/docs
